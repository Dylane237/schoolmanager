# Variables publiques (optionnel — des valeurs par défaut existent déjà)

# App web + API licences (déjà sur Vercel gratuit)
# NEXT_PUBLIC_LICENCE_SERVER_URL=https://schoolmanager-eosin.vercel.app

# Téléchargement Windows — GitHub Releases (gratuit, sans domaine)
# NEXT_PUBLIC_GITHUB_REPO=Dylane237/schoolmanager
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://github.com/Dylane237/schoolmanager/releases/latest/download/SchoolManager-Setup.exe

# Version affichée sur /telecharger (sinon lue depuis package.json au build)
# NEXT_PUBLIC_APP_VERSION=1.0.0

# Supabase (gratuit) — côté serveur uniquement, jamais committer les clés
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
